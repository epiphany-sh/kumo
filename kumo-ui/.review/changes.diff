  addTearDown(tester.view.reset);
  final state = AppState(demoWallpaper: true);
  await tester.pumpWidget(KumoApp(state: state));
  await tester.pump();
  await tester.tap(find.byTooltip(ContextTab.files.tooltip));
  await tester.pump();
  return state;
