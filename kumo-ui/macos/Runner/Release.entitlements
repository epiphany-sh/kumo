<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Kumo runs shells and agent CLIs and launches its daemon (kumod):
	     incompatible with the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Its frameworks aren't signed by a team (Kumo has no Developer ID), which
	     the hardened runtime would otherwise refuse to load. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
