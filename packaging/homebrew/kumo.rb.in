# Generated by `make release`; published to @RELEASE_ORG@/homebrew-kumo.
cask "kumo" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@RELEASE_REPO@/releases/download/v#{version}/Kumo-#{version}.zip"
  name "Kumo"
  desc "Terminal workspace for worktrees, agents and tickets"
  homepage "https://github.com/@RELEASE_REPO@"

  auto_updates true
  depends_on arch: :arm64
  depends_on macos: :monterey

  app "Kumo.app"

  # Kumo isn't notarized: without this, Gatekeeper stops its first launch.
  postflight_steps do
    run "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "{{appdir}}/Kumo.app"]
  end

  zap trash: [
    "~/Library/Application Support/kumo",
    "~/Library/Preferences/dev.kumo.kumoUi.plist",
  ]
end
